datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  MENTOR
  ADMIN
  SUPER_ADMIN
}

enum ResourceType {
  VIDEO
  PDF
  SLIDE
  DOCUMENT
  ARTICLE
  LINK
  CODE
  GITHUB
  FIGMA
  DATASET
  CHEATSHEET
  PRACTICE
  OTHER
}

enum AssignmentType {
  PROJECT
  EXERCISE
  PRACTICE
  QUIZ
  OTHER
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum SessionMode {
  VIRTUAL
  PHYSICAL
  HYBRID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
  REMINDER
}

enum NotificationType {
  ASSIGNMENT_NEW
  ASSIGNMENT_GRADED
  SUBMISSION_RECEIVED
  SESSION_NEW
  SESSION_REMINDER
  RESOURCE_NEW
  ANNOUNCEMENT_NEW
  ENROLLMENT_CONFIRMED
  GENERAL
}

model User {
  id                      String   @id @default(cuid())
  firstName               String
  lastName                String
  displayName             String?
  email                   String   @unique
  passwordHash            String
  role                    Role     @default(STUDENT)
  avatarUrl               String?
  avatarPublicId          String?
  bio                     String?  @db.Text
  githubUrl               String?
  linkedinUrl             String?
  isActive                Boolean  @default(true)
  onboardingCompleted     Boolean  @default(false)
  notificationPreferences Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  enrollments         Enrollment[]
  mentorAssignments   MentorAssignment[]
  createdAssignments  Assignment[]         @relation("AssignmentCreator")
  submissions         Submission[]
  attendances         Attendance[]         @relation("StudentAttendance")
  markedAttendances   Attendance[]         @relation("AttendanceMarker")
  announcements       Announcement[]       @relation("AnnouncementAuthor")
  lessonProgress      LessonProgress[]
  uploadedResources   Resource[]           @relation("ResourceUploader")
  mentorSessions      Session[]            @relation("MentorSessions")
  createdInvites      Invite[]             @relation("InviteCreator")
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]

  @@index([role])
  @@index([isActive])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Bootcamp {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cohorts Cohort[]
  invites Invite[]
}

model Cohort {
  id         String    @id @default(cuid())
  name       String
  bootcampId String
  bootcamp   Bootcamp  @relation(fields: [bootcampId], references: [id], onDelete: Cascade)
  startDate  DateTime
  endDate    DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tracks  Track[]
  invites Invite[]

  @@index([bootcampId])
}

model Track {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  accent      String?
  cohortId    String
  cohort      Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments       Enrollment[]
  mentorAssignments MentorAssignment[]
  modules           Module[]
  assignments       Assignment[]
  sessions          Session[]
  announcements     Announcement[]
  invites           Invite[]

  @@index([cohortId])
}

model Invite {
  id                  String    @id @default(cuid())
  code                String    @unique
  bootcampId          String
  bootcamp            Bootcamp  @relation(fields: [bootcampId], references: [id], onDelete: Cascade)
  cohortId            String?
  cohort              Cohort?   @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  trackId             String?
  track               Track?    @relation(fields: [trackId], references: [id], onDelete: SetNull)
  allowTrackSelection Boolean   @default(false)
  maxTrackSelections  Int?      @default(1)
  createdById         String
  createdBy           User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  expiresAt           DateTime?
  maxUses             Int?
  useCount            Int       @default(0)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([isActive])
  @@index([bootcampId])
  @@index([cohortId])
  @@index([trackId])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Restrict)
  enrolledAt DateTime @default(now())
  isActive   Boolean  @default(true)

  @@unique([userId, trackId])
  @@index([trackId])
  @@index([userId])
}

model MentorAssignment {
  id         String   @id @default(cuid())
  mentorId   String
  mentor     User     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([mentorId, trackId])
  @@index([trackId])
}

model Module {
  id          String   @id @default(cuid())
  trackId     String
  track       Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  description String?  @db.Text
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]
  resources   Resource[]
  assignments Assignment[]

  @@index([trackId])
}

model Lesson {
  id              String   @id @default(cuid())
  moduleId        String
  module          Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  slug            String
  description     String?  @db.Text
  content         String?  @db.Text
  durationMinutes Int?
  order           Int
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  resources Resource[]
  progress  LessonProgress[]

  @@index([moduleId])
  @@index([moduleId, isPublished])
  @@index([isPublished])
}

model Resource {
  id               String       @id @default(cuid())
  title            String
  description      String?      @db.Text
  type             ResourceType
  url              String
  publicId         String?
  originalFileName String?
  fileSize         Int?
  mimeType         String?
  lessonId         String?
  lesson           Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  moduleId         String?
  module           Module?      @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  uploadedById     String
  uploadedBy       User         @relation("ResourceUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  isRequired       Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([moduleId])
  @@index([lessonId])
  @@index([uploadedById])
}

model Assignment {
  id           String         @id @default(cuid())
  trackId      String
  track        Track          @relation(fields: [trackId], references: [id], onDelete: Cascade)
  moduleId     String?
  module       Module?        @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  title        String
  description  String         @db.Text
  instructions String?        @db.Text
  dueDate      DateTime?
  points       Int?
  type         AssignmentType
  createdById  String
  createdBy    User           @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  submissions Submission[]

  @@index([trackId])
  @@index([moduleId])
  @@index([dueDate])
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  studentId    String
  student      User             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  githubUrl    String?
  liveUrl      String?
  fileUrl      String?
  filePublicId String?
  fileName     String?
  fileSize     Int?
  notes        String?          @db.Text
  status       SubmissionStatus @default(DRAFT)
  score        Int?
  feedback     String?          @db.Text
  submittedAt  DateTime?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([status])
  @@index([assignmentId, status])
}

model Session {
  id           String      @id @default(cuid())
  trackId      String
  track        Track       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title        String
  description  String?     @db.Text
  startTime    DateTime
  endTime      DateTime
  mode         SessionMode
  meetingUrl   String?
  location     String?
  mentorId     String?
  mentor       User?       @relation("MentorSessions", fields: [mentorId], references: [id], onDelete: SetNull)
  recordingUrl String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  attendances Attendance[]

  @@index([trackId])
  @@index([trackId, startTime])
  @@index([startTime])
}

model Attendance {
  id         String           @id @default(cuid())
  sessionId  String
  session    Session          @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  studentId  String
  student    User             @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Restrict)
  status     AttendanceStatus
  markedAt   DateTime         @default(now())
  markedById String?
  markedBy   User?            @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([sessionId])
  @@index([sessionId, status])
}

model Announcement {
  id        String               @id @default(cuid())
  title     String
  content   String               @db.Text
  priority  AnnouncementPriority @default(NORMAL)
  trackId   String?
  track     Track?               @relation(fields: [trackId], references: [id], onDelete: SetNull)
  authorId  String
  author    User                 @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([trackId, createdAt])
  @@index([createdAt])
}

model LessonProgress {
  id          String    @id @default(cuid())
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  studentId   String
  student     User      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  readAt    DateTime?
  eventKey  String?
  createdAt DateTime         @default(now())

  @@unique([userId, eventKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}
